{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Context Index",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "projects",
    "routing_rule"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "kind": {
      "const": "context-index"
    },
    "routing_rule": {
      "const": "EXPLICIT_PROJECT_AND_TICKET; NEVER_LATEST_TIMESTAMP"
    },
    "active_context": {
      "type": "null"
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "project_id",
          "checkpoint_path"
        ],
        "properties": {
          "project_id": {
            "type": "string"
          },
          "checkpoint_path": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
